# Copy to .env.local and fill in. Never commit real values.

# Convex (written automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Elastic Cloud Serverless project: endpoint URL + API key (Step 3)
ELASTIC_URL=
ELASTIC_API_KEY=

# Server-side only. In production these go in Convex env vars (npx convex env set NAME value)
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
